# ─────────────────────────────────────────────────────────────────────────────
# Linha Farma — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=linhafarma
POSTGRES_USER=linhafarma
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Backend ──────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT signing secret. Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRATION_MINUTES=60

# ── AI (Ollama) ──────────────────────────────────────────────────────────────
# Ollama is reachable only from the backend network — never exposed publicly.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=20

# ── Safety engine ────────────────────────────────────────────────────────────
# Minutes before an unassigned escalation is flagged as breaching SLA.
ESCALATION_SLA_MINUTES=5

# ── Reservations ─────────────────────────────────────────────────────────────
# Hours before an uncollected reservation expires and stock is returned.
RESERVATION_EXPIRY_HOURS=48

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
